<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of this app goes into a cloud backup or a transfer to a new phone: the session and the
     cached payslips are encrypted with keys that stay on this phone, and a new phone signs in again. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
  </device-transfer>
</data-extraction-rules>
