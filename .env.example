# The domain of the app logins made from employee numbers. Must match EMPLOYEE_LOGIN_DOMAIN of the
# activate-employee Edge Function. Change it only together with Bannuar (README: To confirm).
EMPLOYEE_LOGIN_DOMAIN=employees.bannuar.invalid

# Push notifications stay off until Bannuar's Firebase files are in the app (README: Push
# notifications). Then set true and rebuild.
PUSH_ENABLED=false
