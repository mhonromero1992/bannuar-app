# only to point a build at another project (a staging copy). Everything here is built into the app,
# where anyone can read it: never put the service role (secret) key here.
SUPABASE_URL=https://bcynizcgdgqznlxuzwjx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_rwAYUkMVmJxXiT9SnrqlxA_VsMFHK25

# The public website: the privacy notice (/privacy) and the certificate check (/verify).
